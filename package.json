{
  "name": "slides",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node \"decks/backend-workshop/scripts/import-content.mjs\" && node \"decks/backend-workshop/scripts/build-lessons.mjs\"",
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run content && npm run typecheck && vite build",
    "build:test": "npm run content && npm run typecheck && vite build --outDir .preview-dist --mode test",
    "start": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:examples": "python3 \"decks/backend-workshop/scripts/check-examples.py\""
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@ibm/plex-mono": "^2.5.0",
    "@ibm/plex-sans": "^1.1.0",
    "@ibm/plex-sans-tc": "^1.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
